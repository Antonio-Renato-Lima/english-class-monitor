# Configurações do Servidor Flask
PORT=8002
HOST=127.0.0.1
DEBUG=True
SECRET_KEY=aulas-ingles-secret-key-2026

# Banco de Dados SQLite
DB_NAME=aulas_ingles.db

# Whisper (Transcrição Local por IA)
WHISPER_MODEL=small.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Ollama Local (Resumo, Vocabulário e Gramática)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=qwen3:8b

# Captura de Tela
SCREENSHOT_INTERVAL=15
SLIDE_CHANGE_THRESHOLD=0.04
MONITOR_INDEX=0

# Google Cloud Translation (API oficial). Deixe a chave vazia para usar apenas os tradutores gratuitos.
# O sistema para de usar a API oficial ao atingir o limite mensal de caracteres (o contador zera todo mes).
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_MONTHLY_LIMIT=500000
